+    // NOTE (wallpaper-engine-kde-plugin local patch): video textures play in real time (mpv's
+    // untimed mode is disabled), so the plugin's playback speed has to be forwarded to mpv for
+    // them to follow it. Only touch mpv when the configured value actually changed.
+    const double playbackRate = this->getContext ().getContext ().config.playbackRate;
+
+    if (playbackRate != this->m_appliedPlaybackRate) {
+	double rate = playbackRate;
+
+	mpv_set_property (this->m_handle, "speed", MPV_FORMAT_DOUBLE, &rate);
+	this->m_appliedPlaybackRate = playbackRate;
+    }
+
