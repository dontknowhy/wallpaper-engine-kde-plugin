diff --git a/src/core/WallpaperEngine/Render/CTexture.cpp b/src/core/WallpaperEngine/Render/CTexture.cpp
index 475c482..e59a10c 100644
--- a/src/core/WallpaperEngine/Render/CTexture.cpp
+++ b/src/core/WallpaperEngine/Render/CTexture.cpp
@@ -37,7 +37,11 @@ CTexture::CTexture (RenderContext& context, TextureUniquePtr header) :
 	// setup texture video player
 	this->m_player->setMuted ();
 	this->m_player->setVolume (0.0f);
-	this->m_player->setUntimed ();
+	// NOTE (wallpaper-engine-kde-plugin local patch): mpv's untimed mode makes
